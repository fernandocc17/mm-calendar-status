[Unit]
Description=Mattermost status sync timer

[Timer]
# Every 5 minutes, on the wall-clock (00, 05, 10, ...). Pair with the script's
# lookahead_minutes so the status flips just before :00/:15/:30/:45 meetings.
OnCalendar=*:0/5
# Catch up on a missed run (e.g. laptop was suspended) on next wake.
Persistent=true

[Install]
WantedBy=timers.target
